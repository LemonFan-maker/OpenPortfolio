FROM node:22-alpine AS deps
WORKDIR /app
COPY package.json package-lock.json ./
COPY apps/web/package.json apps/web/package.json
RUN npm ci

FROM node:22-alpine AS builder
WORKDIR /app
ARG API_BASE_URL=http://localhost:7020
ARG NEXT_PUBLIC_API_BASE_URL=
ARG NEXT_PUBLIC_BLOG_URL=
ARG NEXT_PUBLIC_GITHUB_URL=
ARG NEXT_PUBLIC_SITE_NAME=
ARG NEXT_PUBLIC_SITE_DESCRIPTION=
ARG SITE_NAME=
ARG SITE_DESCRIPTION=
ENV API_BASE_URL=$API_BASE_URL \
    NEXT_PUBLIC_API_BASE_URL=$NEXT_PUBLIC_API_BASE_URL \
    NEXT_PUBLIC_BLOG_URL=$NEXT_PUBLIC_BLOG_URL \
    NEXT_PUBLIC_GITHUB_URL=$NEXT_PUBLIC_GITHUB_URL \
    NEXT_PUBLIC_SITE_NAME=$NEXT_PUBLIC_SITE_NAME \
    NEXT_PUBLIC_SITE_DESCRIPTION=$NEXT_PUBLIC_SITE_DESCRIPTION \
    SITE_NAME=$SITE_NAME \
    SITE_DESCRIPTION=$SITE_DESCRIPTION \
    NEXT_TELEMETRY_DISABLED=1
COPY --from=deps /app/node_modules ./node_modules
COPY . .
RUN npm --workspace apps/web run build

FROM node:22-alpine AS runner
WORKDIR /app
ARG API_BASE_URL=http://localhost:7020
ARG NEXT_PUBLIC_API_BASE_URL=
ARG NEXT_PUBLIC_BLOG_URL=
ARG NEXT_PUBLIC_GITHUB_URL=
ARG NEXT_PUBLIC_SITE_NAME=
ARG NEXT_PUBLIC_SITE_DESCRIPTION=
ARG SITE_NAME=
ARG SITE_DESCRIPTION=
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    API_BASE_URL=$API_BASE_URL \
    NEXT_PUBLIC_API_BASE_URL=$NEXT_PUBLIC_API_BASE_URL \
    NEXT_PUBLIC_BLOG_URL=$NEXT_PUBLIC_BLOG_URL \
    NEXT_PUBLIC_GITHUB_URL=$NEXT_PUBLIC_GITHUB_URL \
    NEXT_PUBLIC_SITE_NAME=$NEXT_PUBLIC_SITE_NAME \
    NEXT_PUBLIC_SITE_DESCRIPTION=$NEXT_PUBLIC_SITE_DESCRIPTION \
    SITE_NAME=$SITE_NAME \
    SITE_DESCRIPTION=$SITE_DESCRIPTION
COPY --from=builder /app/apps/web/public ./apps/web/public
COPY --from=builder /app/apps/web/.next/standalone ./
COPY --from=builder /app/apps/web/.next/static ./apps/web/.next/static
EXPOSE 3000
CMD ["node", "apps/web/server.js"]
