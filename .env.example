# GitHub
GITHUB_USERNAME=
GITHUB_TOKEN=
# 逗号分隔；为空时自动选择精选项目
FEATURED_REPOS=
# 逗号分隔；隐藏仓库不会出现在列表、详情和 AI 摘要中
HIDDEN_REPOS=

# AI
# opencode（默认）：使用 OpenCode Go/Console 推理，填写 OPENCODE_API_KEY
# openai：回退到旧 OpenAI 兼容接口，填写 AI_API_KEY
AI_PROVIDER=opencode
OPENCODE_API_KEY=
# Go 订阅使用该地址；/inference/openai/v1 会按 Console 余额计费，余额为 0 时返回 402
OPENCODE_BASE_URL=https://opencode.ai/inference/go/openai/v1
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
# 留空使用提供方默认值：opencode=deepseek-v4.1-flash，openai=gpt-4o-mini
AI_MODEL=
# 公开 AI 接口限流：单 IP/分钟、全局/分钟、全局并发
AI_PUBLIC_PER_MINUTE=6
AI_PUBLIC_GLOBAL_PER_MINUTE=30
AI_PUBLIC_MAX_CONCURRENCY=2

# Site
BLOG_URL=
SITE_NAME=
SITE_DESCRIPTION=

# Admin
# 两项都必须修改；默认值或过短会禁用后台登录和管理接口
ADMIN_PASSWORD=
JWT_SECRET=
# HTTPS 部署设为 true；留空按 WEB_ORIGIN 自动判断
ADMIN_COOKIE_SECURE=
# 信任的代理 IP/CIDR，逗号分隔；Docker Compose 默认覆盖为 Docker 网段
# TRUSTED_PROXIES=

# Redis
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# Server
SERVER_PORT=7020
WEB_ORIGIN=http://localhost:3000
# 服务端请求后端的内部地址；Docker 中为 http://server:7020
API_BASE_URL=http://localhost:7020

# Frontend
# 留空表示浏览器使用同源 /api；仅前后端分域时填写绝对地址
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_BLOG_URL=
NEXT_PUBLIC_SITE_NAME=
NEXT_PUBLIC_SITE_DESCRIPTION=
NEXT_PUBLIC_GITHUB_URL=
